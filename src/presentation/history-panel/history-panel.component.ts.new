import { Component, signal, computed, output, ChangeDetectorRef, TemplateRef, ViewChild, ViewContainerRef, AfterViewInit, effect, ChangeDetectionStrategy, DestroyRef } from '@angular/core';
import { toSignal } from '@angular/core/rxjs-interop';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { IntegratedHistoryStorageService, HistoryItem, StorageInfo, FileSystemStorageState, FolderReconnectionPrompt } from '../../integration/history-storage.service';
import { PlaybackService } from '../../integration/playback.service';
import { StorageInfoComponent } from './components/storage-info/storage-info.component';
import { FileSystemManagerComponent } from './components/file-system-manager/file-system-manager.component';
import { TruncateTextPipe } from '../shared/pipes/truncate-text.pipe';
import { FormatDatePipe } from '../shared/pipes/format-date.pipe';
import { FormatDurationPipe } from '../shared/pipes/format-duration.pipe';
import { FormatFileSizePipe } from '../shared/pipes/format-file-size.pipe';
import { ModelProvider } from '../../integration/domain-types';
import { ModalService } from '../../shared/modal.service';

@Component({
  selector: 'app-history-panel',
  standalone: true,
  imports: [
    CommonModule,
    FormsModule,
    StorageInfoComponent,
    FileSystemManagerComponent,
    TruncateTextPipe,
    FormatDatePipe
  ],
  template: `
    <!-- Reconnect Modal Template -->
    <ng-template #reconnectModal let-prompt>
      <div class="modal-content">
        <div class="modal-header"><h3>Reconnect to Folder</h3></div>
        <div class="modal-body">
          <p>You previously selected: "{{ prompt.previousPath }}".</p>
          <p>Would you like to reconnect?</p>
        </div>
        <div class="modal-footer">
          <button class="modal-btn" (click)="onReconnectConfirm(true)">Reconnect</button>
          <button class="modal-btn secondary" (click)="onReconnectConfirm(false)">Cancel</button>
        </div>
      </div>
    </ng-template>

    <!-- Main History Panel -->
    <div class="history-panel">
      <!-- Storage Info Component -->
      <app-storage-info
        [storageInfo]="storageInfo()"
        [showStorageBar]="showStorageBar()"
        [warningLevel]="storageWarningLevel()">
      </app-storage-info>

      <!-- File System Manager Component -->
      <app-file-system-manager
        [state]="fileSystemState()"
        (toggleStorage)="onToggleStorage()"
        (changeFolder)="onChangeFolder()">
      </app-file-system-manager>

      <!-- Delete Confirmation Modal -->
      @if (showDeleteModal()) {
      <div class="modal-overlay">
        <div class="modal-content">
          <div class="modal-header">
            <h3>Delete Item</h3>
            <button class="modal-close-btn" (click)="cancelDeleteItem()">
              <img src="assets/icons/outline/x.svg" width="20" height="20" alt="Close">
            </button>
          </div>
          <div class="modal-body">
            <div class="modal-icon">
              <img src="assets/icons/outline/alert-triangle.svg" width="48" height="48" alt="Warning">
            </div>
            <p>Are you sure you want to delete this TTS item?</p>
            @if (itemToDelete()) {
              <p class="modal-warning">"{{ itemToDelete()!.text | truncateText:100 }}"</p>
            }
          </div>
          <div class="modal-footer">
            <button class="modal-btn secondary" (click)="cancelDeleteItem()">
              Cancel
            </button>
            <button class="modal-btn danger" (click)="onDeleteConfirm()">
              <img src="assets/icons/outline/trash.svg" width="16" height="16" class="inline-icon" alt="Trash">
              Delete
            </button>
          </div>
        </div>
      </div>
      }

      <!-- Clear All Confirmation Modal -->
      @if (showClearModal()) {
      <div class="modal-overlay">
        <div class="modal-content">
          <div class="modal-header">
            <h3>Clear All History</h3>
            <button class="modal-close-btn" (click)="cancelClearAll()">
              <img src="assets/icons/outline/x.svg" width="20" height="20" alt="Close">
            </button>
          </div>
          <div class="modal-body">
            <div class="modal-icon">
              <img src="assets/icons/outline/alert-triangle.svg" width="48" height="48" alt="Warning">
            </div>
            <p>Are you sure you want to clear all TTS history?</p>
            <p class="modal-warning">This action cannot be undone and will permanently delete {{ storageInfo().itemCount }} items.</p>
          </div>
          <div class="modal-footer">
            <button class="modal-btn secondary" (click)="cancelClearAll()">
              Cancel
            </button>
            <button class="modal-btn danger" (click)="onClearAllConfirm()">
              <img src="assets/icons/outline/trash.svg" width="16" height="16" class="inline-icon" alt="Trash">
              Clear All
            </button>
          </div>
        </div>
      </div>
      }

      <!-- Main History Content -->
      <div class="history-content">
        <ng-container *ngIf="filteredHistory().length === 0; else listContent">
          <div class="empty-state">
            <ng-container *ngIf="searchQuery(); else noSearch">
              <div class="empty-icon">
                <img src="assets/icons/outline/search.svg" width="48" height="48" alt="Search">
              </div>
              <div class="empty-message">No items match your search</div>
            </ng-container>
            <ng-template #noSearch>
              <div class="empty-icon">
                <img src="assets/icons/outline/calendar-time.svg" width="48" height="48" alt="Calendar">
              </div>
              <div class="empty-message">No TTS history yet</div>
              <div class="empty-hint">Generated speech will appear here</div>
            </ng-template>
          </div>
        </ng-container>
        <ng-template #listContent>
          <div class="history-list">
            <div class="history-item"
                 *ngFor="let item of filteredHistory(); trackBy: trackByFn"
                 [class.selected]="selectedItemId() === item.id"
                 (click)="selectItem(item)"
                 (keyup.enter)="selectItem(item)"
                 (keyup.space)="selectItem(item)"
                 tabindex="0"
                 role="button"
                 [attr.aria-label]="'Select history item: ' + item.text">
              <!-- Item Content -->
              <div class="item-content">
                <div class="item-meta">
                  <div class="provider-info">
                    <img [src]="'assets/icons/filled/microphone.svg'" width="14" height="14" class="inline-icon" [alt]="'Voice icon'">
                    <span class="language-code">{{ item.settings.voice }}</span>
                  </div>
                  <div class="timestamp">{{ item.createdAt | formatDate }}</div>
                </div>

                <!-- Item Actions -->
                <div class="item-actions">
                  <button 
                    class="item-action-btn play-btn" 
                    (click)="onHistoryItemPlayPauseClick(item, $event)"
                    [title]="playbackService.playingItemId() === item.id && playbackService.isPlaying() ? 'Pause audio' : 'Play audio'">
                    <img [src]="playbackService.playingItemId() === item.id && playbackService.isPlaying() ? 'assets/icons/outline/player-pause.svg' : 'assets/icons/outline/player-play.svg'" 
                         width="14" height="14" class="action-icon" 
                         [alt]="playbackService.playingItemId() === item.id && playbackService.isPlaying() ? 'Pause' : 'Play'">
                  </button>
                  <button 
                    class="item-action-btn download-btn" 
                    (click)="onDownloadHistoryItem(item, $event)"
                    title="Download audio">
                    <img src="assets/icons/outline/download.svg" width="14" height="14" class="action-icon" alt="Download">
                  </button>
                  <button 
                    class="item-action-btn delete-btn" 
                    (click)="deleteItem(item, $event)"
                    title="Delete item">
                    <img src="assets/icons/outline/trash.svg" width="14" height="14" class="action-icon" alt="Delete">
                  </button>
                </div>
              </div>
            </div>
          </div>
        </ng-template>
      </div>
    </div>
  `,
  styles: [`
    .history-panel {
      height: 100%;
    }
  `],
  changeDetection: ChangeDetectionStrategy.OnPush
})
export class HistoryPanelComponent implements AfterViewInit {
  @ViewChild('reconnectModal') reconnectModal!: TemplateRef<{ $implicit: FolderReconnectionPrompt }>;

  // Outputs
  historyItemSelected = output<HistoryItem | null>();
  playItem = output<HistoryItem>();

  // State signals
  searchQuery = signal('');
  selectedItemId = signal<string | null>(null);
  showDeleteModal = signal(false);
  showClearModal = signal(false);
  itemToDelete = signal<HistoryItem | null>(null);
  history = signal<HistoryItem[]>([]);
  storageInfo = signal<StorageInfo>({ used: 0, available: 0, total: 0, usedPercentage: 0, itemCount: 0 });
  fileSystemState = signal<FileSystemStorageState>({ 
    isSupported: false, 
    isEnabled: false, 
    directoryHandle: null, 
    selectedPath: null 
  });

  // Signals from observables
  private readonly history$ = toSignal(this.historyService.history$, { initialValue: [] });
  private readonly storageInfo$ = toSignal(this.historyService.storageInfo$, { 
    initialValue: { used: 0, available: 0, total: 0, usedPercentage: 0, itemCount: 0 } 
  });
  private readonly fileSystemState$ = toSignal(this.historyService.fileSystemState$, {
    initialValue: {
      isSupported: false,
      isEnabled: false,
      directoryHandle: null,
      selectedPath: null
    }
  });
  private readonly folderReconnectionPrompt$ = toSignal(this.historyService.folderReconnectionPrompt$);

  // Computed state
  filteredHistory = computed(() => {
    const query = this.searchQuery().toLowerCase();
    if (!query) return this.history$();
    
    return this.history$().filter(item => 
      item.text.toLowerCase().includes(query) ||
      item.metadata?.title?.toLowerCase().includes(query) ||
      item.metadata?.tags?.some(tag => tag.toLowerCase().includes(query))
    );
  });

  storageWarningLevel = computed(() => {
    const percentage = this.storageInfo$().usedPercentage;
    if (percentage > 0.9) return 'critical';
    if (percentage > 0.8) return 'warning';
    return 'normal';
  });

  showStorageBar = computed(() => {
    return !this.fileSystemState$().isEnabled;
  });

  constructor(
    public modalService: ModalService,
    private cdr: ChangeDetectorRef,
    private historyService: IntegratedHistoryStorageService,
    public playbackService: PlaybackService,
    private destroyRef: DestroyRef
  ) {
    // Handle folder reconnection prompts with effects
    effect(() => {
      const prompt = this.folderReconnectionPrompt$();
      if (!prompt) return;

      this.modalService.show({
        template: this.reconnectModal,
        context: { $implicit: prompt }
      });

      const result = this.modalService.getResult<boolean>();
      if (result !== null) {
        this.historyService.handleFolderReconnection(result);
      }
    });
  }

  ngAfterViewInit(): void {
    // No longer needed since we're using toSignal and effect
  }

  // Modal actions
  onReconnectConfirm(confirmed: boolean): void {
    this.modalService.close(confirmed);
  }

  onDeleteConfirm(): void {
    const item = this.itemToDelete();
    if (item) {
      this.historyService.deleteHistoryItem(item.id);
      this.showDeleteModal.set(false);
      this.itemToDelete.set(null);
    }
  }

  onClearAllConfirm(): void {
    this.historyService.clearHistory();
    this.showClearModal.set(false);
  }

  // Modal cancel handlers
  cancelDeleteItem(): void {
    this.showDeleteModal.set(false);
    this.itemToDelete.set(null);
  }

  cancelClearAll(): void {
    this.showClearModal.set(false);
  }

  // History item actions
  selectItem(item: HistoryItem): void {
    this.selectedItemId.set(item.id);
    this.historyItemSelected.emit(item);
  }

  async onHistoryItemPlayPauseClick(item: HistoryItem, event: Event): Promise<void> {
    event.stopPropagation();
    if (!event.isTrusted) return;

    if (this.playbackService.playingItemId() === item.id && this.playbackService.isPlaying()) {
      this.playbackService.pause();
    } else {
      this.selectItem(item);
      this.playItem.emit(item);
    }
  }

  async onDownloadHistoryItem(item: HistoryItem, event: Event): Promise<void> {
    event.stopPropagation();
    
    const fileName = `tts-${item.id}-${item.settings.provider.toLowerCase()}.mp3`;
    const audioData = item.result.audioData;
    
    if (audioData) {
      const blob = new Blob([audioData], { type: 'audio/mpeg' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  }

  async deleteItem(item: HistoryItem, event: Event): Promise<void> {
    event.stopPropagation();
    if (this.playbackService.playingItemId() === item.id) {
      this.playbackService.stop();
    }
    this.itemToDelete.set(item);
    this.showDeleteModal.set(false);
  }

  // File system actions
  onToggleStorage(): void {
    // Handle toggle storage
  }

  onChangeFolder(): void {
    // Handle folder change
  }

  // Utility functions
  trackByFn(index: number, item: HistoryItem): string {
    return item.id;
  }
}
